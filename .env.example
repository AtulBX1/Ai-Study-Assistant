# Native development uses local adapters; use BACKEND=prod for deployment adapters.
BACKEND=local

# SQLAlchemy URL. Local default stores SQLite data under backend/data/.
DATABASE_URL=sqlite:///./data/study_assistant.db

# JWT signing key must be at least 32 characters in production.
JWT_SECRET_KEY=replace-this-with-a-long-random-production-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
RATE_LIMIT_IP_PER_MINUTE=120
RATE_LIMIT_USER_PER_MINUTE=60

# Local adapter paths.
QDRANT_LOCAL_PATH=./data/qdrant
STORAGE_PATH=../storage
MAX_PDF_SIZE_BYTES=20971520
MAX_PDF_PAGES=500

# Production adapter configuration (required when BACKEND=prod).
# DATABASE_URL=postgresql+psycopg://user:password@db-host:5432/study_assistant
# REDIS_URL=redis://redis-host:6379/0
# QDRANT_URL=https://qdrant.example.com
# S3_ENDPOINT_URL=https://s3.example.com
# S3_REGION=us-east-1
# S3_BUCKET=study-documents
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
#
# Additional deployment artifact configuration for docker-compose.prod.yml:
# POSTGRES_DB=study_assistant
# POSTGRES_USER=study_assistant
# POSTGRES_PASSWORD=
# MINIO_ROOT_USER=
# MINIO_ROOT_PASSWORD=

BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
MLFLOW_TRACKING_URI=file:./mlruns
MLFLOW_PORT=5000
# Enable optional MLflow logging in the retrieval evaluation runner.
RETRIEVAL_EVAL_MLFLOW=false
